---
// The store's categories as tall photo tiles, each named on a white chip; a
// last tile leads to every product. A row a phone swipes, a grid on a wide
// screen. A category without a photo of its own shows one of its products.
import { message } from "@/theme/content/messages";
import { Image } from "astro:assets";
import type { Category, ProductList } from "@wocart/storefront";
import { storefrontPath } from "@wocart/storefront";
import type { InferProps } from "@wocart/theme";
import { isPreview, type BlocksHandle } from "@wocart/theme/astro";
import { Icon } from "astro-icon/components";
import type { StoreFrontContent } from "@/theme/content";
import type { categoryCards } from "@/theme/catalog/home/category-cards.def";
import { homeSectionStateOf } from "@/theme/runtime/home-sections";
import Section from "@/theme/components/ui/Section.astro";
import SectionHead from "@/theme/components/ui/SectionHead.astro";
import { imageSource, imageSrcset } from "@/theme/utils/images";

type Props = InferProps<typeof categoryCards> & {
  blocks: BlocksHandle;
  categories: Category[];
  /** The catalog, shared with the other sections: a category with no photo of its own shows one of its products. */
  products?: ProductList[];
  content: StoreFrontContent;
};

const { blocks, categories, products = [], content, limit, showAll, headingAlign, scheme, style } = Astro.props;
const store = Astro.locals.store;
const section = homeSectionStateOf(store, "category-cards");

type TilePhoto = { url: string; width: number | null; height: number | null };

const photoFor = (category: Category): TilePhoto | null => {
  if (category.image) {
    return { url: category.image.url, width: category.image.width, height: category.image.height };
  }
  const cover = products.find((product) => product.categoryId === category.id && product.coverImage)?.coverImage;
  return cover ? { url: cover.url, width: cover.width, height: cover.height } : null;
};

const isIcon = (photo: TilePhoto): boolean => {
  const largest = Math.max(photo.width ?? 0, photo.height ?? 0);
  return largest <= 128 && largest >= 1;
};

// A copy: the page shares this array with other sections, so sorting in place
// would reorder their reads too.
const shown = [...categories].sort((a, b) => a.position - b.position).slice(0, limit);
const tiles = shown.length + (showAll ? 1 : 0);
---

{(shown.length > 0 || isPreview(blocks)) && (
  <Section scheme={scheme} style={style} colors={section.colors}>
    <SectionHead title={content.categoriesSection} center={headingAlign === "center"} />
    <ul class="category-tiles swipe-row" style={`--tiles: ${Math.min(tiles, 5)}`}>
      {shown.map((category) => {
        const photo = photoFor(category);
        const icon = photo ? isIcon(photo) : false;
        return (
          <li>
            <a
              href={store.href(storefrontPath("category", { slug: category.slug }))}
              class:list={["category-tile", "plate", icon && "is-icon"]}
              aria-label={message(content, "ariaBrowseCategoryProducts", { category: category.name }, store.locale)}
            >
              {photo ? (
                photo.width !== null && photo.height !== null ? (
                  <Image
                    src={photo.url}
                    alt=""
                    width={photo.width}
                    height={photo.height}
                    widths={icon ? undefined : [300, 450, 600]}
                    sizes={icon ? undefined : "(min-width: 1024px) 18vw, 62vw"}
                    fit="scale-down"
                    quality={icon ? 100 : 82}
                    loading="lazy"
                    decoding="async"
                    data-category-photo
                  />
                ) : (
                  <img
                    src={imageSource(photo.url, store.config.media, 600)}
                    srcset={imageSrcset(photo.url, store.config.media, [300, 450, 600])}
                    sizes="(min-width: 1024px) 18vw, 62vw"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    data-category-photo
                    data-category-icon="auto"
                  />
                )
              ) : (
                <span class="category-initial" aria-hidden="true">{category.name.charAt(0)}</span>
              )}
              <span class="category-chip">{category.name}</span>
            </a>
          </li>
        );
      })}
      {showAll && (
        <li>
          <a href={store.href(storefrontPath("catalog"))} class="category-tile category-all">
            <span class="category-all-go" aria-hidden="true"><Icon name="heroicons:arrow-up-left" /></span>
            <span class="category-chip category-all-name">{content.allProductsSection}</span>
          </a>
        </li>
      )}
    </ul>
  </Section>
)}

<style>
  .category-tiles {
    --tile-max: 16rem;
    --tile-gap: 1.25rem;
    grid-auto-columns: minmax(0, 46%);
    grid-auto-rows: 1fr;
    align-items: stretch;
    padding-bottom: 1rem;
    list-style: none;
  }
  .category-tiles > li { display: flex; width: 100%; max-width: var(--tile-max); justify-self: center; }
  @media (min-width: 640px) { .category-tiles { grid-auto-columns: minmax(0, 30%); } }
  @media (min-width: 1024px) {
    .category-tiles {
      grid-auto-flow: row;
      grid-auto-rows: auto;
      grid-template-columns: repeat(var(--tiles), minmax(0, 1fr));
      width: min(100%, calc(var(--tiles) * var(--tile-max) + (var(--tiles) - 1) * var(--tile-gap)));
      gap: var(--tile-gap);
      margin: 0 auto;
      padding: 0;
      overflow: visible;
    }
  }
  .category-tile { display: block; width: 100%; height: 100%; min-height: 0; aspect-ratio: 4 / 5; color: var(--clr-ink); text-decoration: none; }
  .category-tile > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s var(--ease-out-expo);
  }
  @media (hover: hover) { .category-tile:hover > :global(img) { transform: scale(1.05); } }
  .category-tile.is-icon { display: grid; place-items: center; }
  .category-tile.is-icon > :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: min(3rem, 100%);
    max-height: 3rem;
    object-fit: contain;
    object-position: center;
    image-rendering: auto;
  }
  @media (hover: hover) { .category-tile.is-icon:hover > :global(img) { transform: none; } }
  .category-initial {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    color: var(--clr-muted);
  }
  .category-chip {
    position: absolute;
    inset-inline-start: 0.875rem;
    bottom: 0.875rem;
    display: -webkit-box;
    max-width: calc(100% - 1.75rem);
    padding: 0.5rem 1rem;
    overflow: hidden;
    border-radius: var(--radius-tag);
    background: var(--clr-bg);
    box-shadow: var(--shadow-md);
    color: var(--clr-ink);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
    text-align: start;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .category-all {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1px solid var(--clr-ink);
    border-radius: var(--radius-media);
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .category-all:hover { background: var(--clr-ink); color: var(--clr-bg); }
  .category-all-name { font-family: var(--font-heading); font-size: var(--text-base); }
  .category-all-go {
    display: inline-flex;
    width: 3.5rem;
    height: 3.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--clr-current);
    border-radius: var(--radius-round);
  }
  .category-all-go :global(svg) { width: 1.375rem; height: 1.375rem; }
  :global([dir="ltr"]) .category-all-go :global(svg) { transform: scaleX(-1); }
</style>

<script src="../../scripts/category-icons.ts"></script>
